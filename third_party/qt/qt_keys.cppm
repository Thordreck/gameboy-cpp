        move_to_start_of_document = QKeySequence::MoveToStartOfDocument,
        move_to_start_of_line = QKeySequence::MoveToStartOfLine,
        new_key = QKeySequence::New,
        next_child = QKeySequence::NextChild,
        open = QKeySequence::Open,
        paste = QKeySequence::Paste,
        preferences = QKeySequence::Preferences,
        previous_child = QKeySequence::PreviousChild,
        print = QKeySequence::Print,
        quit = QKeySequence::Quit,
        redo = QKeySequence::Redo,
        refresh = QKeySequence::Refresh,
        replace = QKeySequence::Replace,
