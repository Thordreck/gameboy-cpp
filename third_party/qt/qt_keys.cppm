    template<event_type Type>
    struct key_event
    {
        static constexpr auto type = Type;
        key key;
    };

    export using key_press_event = key_event<event_type::key_press>;
    export using key_release_event = key_event<event_type::key_release>;

    template<event_type Type>
    struct key_event_factory
    {
        static constexpr key_event<Type> create(const QEvent* event)
        {
            const auto* key_event = static_cast<const QKeyEvent*>(event);
            return { static_cast<key>(key_event->key()) };
        }
    };

    template<>
    struct event_factory<key_press_event>
    {
        static constexpr auto create(const QEvent* event)
        {
            return key_event_factory<event_type::key_press>::create(event);
        }
    };

    template<>
    struct event_factory<key_release_event>
    {
        static constexpr auto create(const QEvent* event)
        {
            return key_event_factory<event_type::key_release>::create(event);
        }
    };

}
